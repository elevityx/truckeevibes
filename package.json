{
  "name": "truckeevibes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node --run snapshot && next build",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:functions": "deno test --config supabase/functions/deno.json supabase/functions",
    "db:start": "sh supabase/start-local.sh",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:concurrency": "node --test scripts/db-concurrency.dbtest.mjs",
    "db:test:rest": "node --test scripts/manifest-rest.dbtest.mjs scripts/api-rest.dbtest.mjs",
    "ingest": "tsx ingest/run.ts",
    "classify-report": "tsx ingest/tools/classify-report.ts",
    "test:static": "cp scripts/fixtures/snapshot-static.json public/data/events.json && next build && node scripts/check-static-snapshot.mjs",
    "build:fixture": "SNAPSHOT_FIXTURE=scripts/fixtures/snapshot-visual.json MANIFEST_FIXTURE=scripts/fixtures/event-pages-visual.json PICKS_PATH=scripts/fixtures/picks-visual.json npm run build",
    "test:visual": "npm run build:fixture && playwright test",
    "test:lhci": "lhci autorun",
    "test:budget": "node scripts/fixtures/make-big-fixture.mjs --events 700 --seed 1 && SNAPSHOT_FIXTURE=.build/fixture/snapshot-700.json MANIFEST_FIXTURE=.build/fixture/event-pages-700.json npm run build && node --test scripts/html-budget.budget.mjs",
    "check:repo": "node scripts/secret-scan.mjs && node scripts/check-workflows.mjs && node scripts/check-fixtures.mjs && node scripts/check-no-html.mjs && node scripts/check-public-copy.mjs && node scripts/build-tokens.mjs --check && node scripts/check-widget.mjs",
    "widget:build": "node widget/build.mjs",
    "check:widget": "node scripts/check-widget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.27.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "happy-dom": "20.14.5",
    "pg": "8.23.1",
    "satori": "0.60.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.1",
    "@supabase/supabase-js": "2.117.3",
    "cheerio": "1.2.0",
    "ical.js": "2.2.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1"
  }
}
